<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.hurlee</groupId>
  <artifactId>hibernate-multiset</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>hibernate-multiset</name>
  <description>
    MULTISET fetch mode for Hibernate ORM 7 (HHH-9558): collections annotated @MultisetFetch are loaded
    as one array_agg(ROW(...)) / json_arrayagg(json_array(...)) column of the owner's statement, without a
    cartesian product and without extra statements. Uses Hibernate's persister/fetch extension points only.
    Build and test with: mvn verify   (docker-maven-plugin starts PostgreSQL, MySQL and MariaDB around the ITs)
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <hibernate.version>7.4.8.Final</hibernate.version>
    <lombok.version>1.18.48</lombok.version>
    <postgres.image>postgres:17-alpine</postgres.image>
    <mysql.image>mysql:8.4</mysql.image>
    <mariadb.image>mariadb:11.8</mariadb.image>
    <!-- postgres.port is NOT declared here on purpose: docker-maven-plugin sets it at runtime
         to the dynamically mapped host port (a pre-set value would be used as a fixed port) -->
  </properties>

  <dependencies>
    <!-- the host application brings Hibernate -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
      <version>${hibernate.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- only needed for the MySQL / MariaDB flavour: json_arrayagg(json_array(...)) -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.2</version>
      <optional>true</optional>
    </dependency>

    <!-- tests -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.53.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
      <version>${hibernate.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.13</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>26.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <version>3.5.10</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId><!-- includes junit-jupiter-params -->
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.252</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!-- Start PostgreSQL before the ITs, stop it afterwards -->
      <plugin>
        <groupId>io.fabric8</groupId>
        <artifactId>docker-maven-plugin</artifactId>
        <version>0.49.0</version>
        <configuration>
          <images>
            <image>
              <name>${postgres.image}</name>
              <alias>postgres</alias>
              <run>
                <env>
                  <POSTGRES_USER>demo</POSTGRES_USER>
                  <POSTGRES_PASSWORD>demo</POSTGRES_PASSWORD>
                  <POSTGRES_DB>demo</POSTGRES_DB>
                </env>
                <ports>
                  <!-- random free host port, exported as Maven property ${postgres.port} -->
                  <port>postgres.port:5432</port>
                </ports>
                <wait>
                  <!-- the init-time temp server does not listen on TCP, so a TCP wait on the
                       mapped port only succeeds once the real server is up -->
                  <tcp>
                    <mode>mapped</mode>
                    <ports><port>5432</port></ports>
                  </tcp>
                  <time>60000</time>
                </wait>
                <log><prefix>[postgres] </prefix></log>
              </run>
            </image>
            <image>
              <name>${mysql.image}</name>
              <alias>mysql</alias>
              <run>
                <env>
                  <MYSQL_ROOT_PASSWORD>demo</MYSQL_ROOT_PASSWORD>
                  <MYSQL_DATABASE>demo</MYSQL_DATABASE>
                </env>
                <ports><port>mysql.port:3306</port></ports>
                <wait>
                  <tcp><mode>mapped</mode><ports><port>3306</port></ports></tcp>
                  <time>120000</time>
                </wait>
                <log><prefix>[mysql] </prefix></log>
              </run>
            </image>
            <image>
              <name>${mariadb.image}</name>
              <alias>mariadb</alias>
              <run>
                <env>
                  <MARIADB_ROOT_PASSWORD>demo</MARIADB_ROOT_PASSWORD>
                  <MARIADB_DATABASE>demo</MARIADB_DATABASE>
                </env>
                <ports><port>mariadb.port:3306</port></ports>
                <wait>
                  <tcp><mode>mapped</mode><ports><port>3306</port></ports></tcp>
                  <time>120000</time>
                </wait>
                <log><prefix>[mariadb] </prefix></log>
              </run>
            </image>
          </images>
        </configuration>
        <executions>
          <execution>
            <id>start-postgres</id>
            <phase>pre-integration-test</phase>
            <goals><goal>start</goal></goals>
          </execution>
          <execution>
            <id>stop-postgres</id>
            <phase>post-integration-test</phase>
            <goals><goal>stop</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Run the standalone JDBC example against the container, before the ITs -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.4</version>
        <executions>
          <execution>
            <id>array-agg-row-example</id>
            <phase>integration-test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>demo.ArrayAggRowExample</mainClass>
              <classpathScope>test</classpathScope>
              <systemProperties>
                <systemProperty>
                  <key>pg.url</key>
                  <value>jdbc:postgresql://localhost:${postgres.port}/demo</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <systemPropertyVariables>
            <postgres.port>${postgres.port}</postgres.port>
            <mysql.port>${mysql.port}</mysql.port>
            <mariadb.port>${mariadb.port}</mariadb.port>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn verify -Penhance : run the same ITs against bytecode-enhanced test entities -->
    <profile>
      <id>enhance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-maven-plugin</artifactId>
            <version>${hibernate.version}</version>
            <executions>
              <execution>
                <id>enhance-test-entities</id>
                <phase>process-test-classes</phase>
                <goals><goal>enhance</goal></goals>
                <configuration>
                  <classesDirectory>${project.build.testOutputDirectory}</classesDirectory>
                  <enableLazyInitialization>true</enableLazyInitialization>
                  <enableDirtyTracking>true</enableDirtyTracking>
                  <!-- off (the plugin default): the test entities maintain both sides of their associations
                       themselves (Author.addBook), which association management would double up -->
                  <enableAssociationManagement>false</enableAssociationManagement>
                  <enableExtendedEnhancement>false</enableExtendedEnhancement>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
